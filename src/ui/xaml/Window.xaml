<!--
  The main window: side navigation, one panel per page, the bottom action bar,
  the activity log, a toast and the in-window dialog layer.

  Static text is {DynamicResource <string key>}: src\ui\Window.ps1 publishes
  every string as a window resource and republishes them on a language switch.
  Everything that changes at run time is a {Binding} to the view model object
  in src\ui\Model.ps1. Controls the scripts wire up by hand carry an x:Name.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1220" Height="840" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
   <ResourceDictionary>
    <!-- src\ui\Window.ps1 fills in the file URI of Theme.xaml before parsing,
         so its styles exist before anything below asks for them. -->
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="__THEME_URI__"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Home page mode card -->
    <Style x:Key="PresetCard" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Padding" Value="16,14,16,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgPressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One line of the preview's "What will happen" tab (src\ui\Summary.ps1).
         Kind picks the look: Lead (the opening sentence), Section (a group
         heading), Item (a bullet) or Note (a callout). Tone 'caution' turns a
         heading or callout amber. -->
    <DataTemplate x:Key="SummaryTemplate">
      <Grid>
        <TextBlock x:Name="Lead" Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" Margin="0,2,0,4" Visibility="Collapsed"/>
        <Grid x:Name="Section" Margin="0,18,0,6" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SectionIcon" Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,10,0"
                     Foreground="{DynamicResource AccentText}"/>
          <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
            <Run Text="{Binding Text, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource TextTertiary}"/>
          </TextBlock>
        </Grid>
        <Grid x:Name="Item" Margin="26,3,0,4" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="5" Height="5" Fill="{DynamicResource TextTertiary}" VerticalAlignment="Top" Margin="0,8,11,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ItemDetail" Text="{Binding Detail}" Style="{StaticResource MonoText}" Margin="0,1,0,0"/>
          </StackPanel>
        </Grid>
        <Border x:Name="Note" Style="{StaticResource InfoBar}" Margin="0,4,0,4" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoteIcon" Text="&#xE946;" Style="{StaticResource IconText}" VerticalAlignment="Top" Margin="0,1,12,0"
                       Foreground="{DynamicResource AccentText}"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="NoteTitle" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock x:Name="NoteDetail" Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Lead"><Setter TargetName="Lead" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Section"><Setter TargetName="Section" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Item"><Setter TargetName="Item" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Note"><Setter TargetName="Note" Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="">
          <Setter TargetName="ItemDetail" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NoteDetail" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="NoteTitle" Property="FontWeight" Value="Normal"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="caution">
          <Setter TargetName="SectionIcon" Property="Foreground" Value="{DynamicResource CautionText}"/>
          <Setter TargetName="Note" Property="Background" Value="{DynamicResource CautionBg}"/>
          <Setter TargetName="NoteIcon" Property="Text" Value="&#xE7BA;"/>
          <Setter TargetName="NoteIcon" Property="Foreground" Value="{DynamicResource CautionText}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A settings row: icon, title and description, and a control on the right -->
    <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="2,0,18,0"/>
    </Style>
   </ResourceDictionary>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Side navigation ================= -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="18,16,16,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Accent}">
          <TextBlock Text="&#xEA18;" Style="{StaticResource IconText}" FontSize="17" HorizontalAlignment="Center"
                     Foreground="{DynamicResource OnAccent}"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource app.name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="16,0,16,10">
        <TextBox x:Name="NavSearch" Tag="{DynamicResource nav.search}" Padding="8,5,32,6"
                 ToolTip="{DynamicResource filter.placeholder}" ToolTipService.InitialShowDelay="900"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/>
      </Grid>

      <ListBox x:Name="NavList" Grid.Row="2" Margin="8,0,8,10" ItemTemplate="{StaticResource NavTemplate}"
               ItemContainerStyle="{StaticResource NavItem}" KeyboardNavigation.TabNavigation="Once"/>
    </Grid>

    <!-- ================= Content layer ================= -->
    <Border Grid.Column="1" Background="{DynamicResource LayerBg}" BorderBrush="{DynamicResource LayerStroke}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="PageHost">

          <!-- ============ Home ============ -->
          <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,34,40,40" MaxWidth="1040">
              <TextBlock Text="{DynamicResource app.name}" Style="{StaticResource TitleText}"/>
              <TextBlock Text="{DynamicResource header.subtitle}" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,6,0,14"/>
              <WrapPanel>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding BraveText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding ChannelChipText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7EF;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{DynamicResource home.admin}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                  </StackPanel>
                </Border>
              </WrapPanel>

              <!-- Drift: settings from the last apply that are no longer in effect
                   (src\core\Drift.ps1). Hidden while everything is in place. -->
              <Border x:Name="DriftBanner" Style="{StaticResource CautionBar}" Margin="0,18,0,0" Visibility="{Binding DriftVisibility}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource CautionText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DriftTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DriftText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,8"/>
                    <ItemsControl ItemsSource="{Binding DriftItems}" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource CautionText}" VerticalAlignment="Top" Margin="0,8,11,0"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                      <Button x:Name="BtnDriftReapply" Style="{StaticResource AccentButton}" Content="{DynamicResource drift.reapply}" Margin="0,0,8,4"
                              Visibility="{Binding DriftReapplyVisibility}" IsEnabled="{Binding IsIdle}"/>
                      <Button x:Name="BtnDriftCleanup" Content="{DynamicResource drift.cleanup}" Margin="0,0,8,4"
                              Visibility="{Binding DriftCleanupVisibility}" IsEnabled="{Binding IsIdle}"/>
                      <Button x:Name="BtnDriftAccept" Style="{StaticResource SubtleButton}" Content="{DynamicResource drift.accept}" Margin="0,0,8,4"
                              IsEnabled="{Binding IsIdle}"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="{DynamicResource home.modesTitle}" Style="{StaticResource SectionText}" Margin="2,22,0,2"/>
              <TextBlock Text="{DynamicResource mode.intro}" Style="{StaticResource SecondaryText}" Margin="2,0,0,10"/>
              <ItemsControl x:Name="PresetCards" ItemsSource="{Binding Presets}" Margin="-4,0,-4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding PresetColumns}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button x:Name="Card" Style="{StaticResource PresetCard}" Margin="4">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                          <TextBlock Text="{Binding Name}" Style="{StaticResource StrongText}" FontSize="15" Margin="0,0,22,0"/>
                          <TextBlock Text="&#xE930;" Style="{StaticResource IconText}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Foreground="{DynamicResource AccentText}" Visibility="{Binding ActiveVisibility}"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/>
                        <Border x:Name="Risk" Grid.Row="2" CornerRadius="10" Padding="9,2,9,3" HorizontalAlignment="Left"
                                Background="{DynamicResource RiskNeutralBg}">
                          <TextBlock x:Name="RiskText" Text="{Binding Risk}" FontSize="12" Foreground="{DynamicResource RiskNeutralFg}"/>
                        </Border>
                      </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSubtleBg}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding RiskLevel}" Value="low">
                        <Setter TargetName="Risk" Property="Background" Value="{DynamicResource RiskLowBg}"/>
                        <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource RiskLowFg}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding RiskLevel}" Value="medium">
                        <Setter TargetName="Risk" Property="Background" Value="{DynamicResource RiskMediumBg}"/>
                        <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource RiskMediumFg}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding RiskLevel}" Value="high">
                        <Setter TargetName="Risk" Property="Background" Value="{DynamicResource RiskHighBg}"/>
                        <Setter TargetName="RiskText" Property="Foreground" Value="{DynamicResource RiskHighFg}"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{DynamicResource home.selectionTitle}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}" Padding="20,16,20,16">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.4*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="{DynamicResource home.statMode}" Style="{StaticResource CaptionText}"/>
                      <TextBlock Text="{Binding ModeName}" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                      <TextBlock Text="{DynamicResource home.statPolicies}" Style="{StaticResource CaptionText}"/>
                      <TextBlock Text="{Binding PolicyStat}" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                      <TextBlock Text="{DynamicResource home.statFlags}" Style="{StaticResource CaptionText}"/>
                      <TextBlock Text="{Binding FlagStat}" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,16,0">
                      <TextBlock Text="{DynamicResource home.statTasks}" Style="{StaticResource CaptionText}"/>
                      <TextBlock Text="{Binding TaskStat}" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="{DynamicResource home.statServices}" Style="{StaticResource CaptionText}"/>
                      <TextBlock Text="{Binding ServiceStat}" Style="{StaticResource SubtitleText}" FontSize="18" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,12"/>
                  <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource SecondaryText}"/>
                  <TextBlock Text="{Binding RiskLine}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnReviewSelected" Content="{DynamicResource home.reviewSelected}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnHomeReload" Content="{DynamicResource util.loadState}" Margin="0,0,8,0" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnHomePolicy" Content="{DynamicResource util.openPolicy}" Style="{StaticResource SubtleButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <TextBlock Text="{DynamicResource header.originNote}" Style="{StaticResource CaptionText}" Margin="2,20,0,0"
                         Foreground="{DynamicResource TextTertiary}"/>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ Settings list (policy category, System, search results) ============ -->
          <ScrollViewer x:Name="PageList" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="40,34,40,40" MaxWidth="1040">
              <TextBlock Text="{Binding ListTitle}" Style="{StaticResource TitleText}"/>
              <Grid Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ListSubtitle}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ChkSelectedOnly" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource filter.selectedOnly}"
                            IsChecked="{Binding SelectedOnly}" Visibility="{Binding SelectedOnlyVisibility}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnSelectAll" Style="{StaticResource SubtleButton}" Content="{DynamicResource policyTab.selectAll}" IsEnabled="{Binding IsIdle}"
                          Visibility="{Binding SelectButtonsVisibility}"/>
                  <Button x:Name="BtnSelectNone" Style="{StaticResource SubtleButton}" Content="{DynamicResource policyTab.selectNone}" IsEnabled="{Binding IsIdle}"
                          Visibility="{Binding SelectButtonsVisibility}" Margin="4,0,0,0"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource CautionBar}" Visibility="{Binding ListIntroVisibility}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource CautionText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding ListIntro}" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <ItemsControl x:Name="ListItems" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" IsHitTestVisible="{Binding IsIdle}"/>
              <StackPanel Visibility="{Binding ListEmptyVisibility}" Margin="0,40,0,0" HorizontalAlignment="Center">
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{DynamicResource filter.noMatches}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ Hosts ============ -->
          <ScrollViewer x:Name="PageHosts" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="40,34,40,40" MaxWidth="1040">
              <TextBlock Text="{DynamicResource tab.hosts}" Style="{StaticResource TitleText}"/>
              <TextBlock Text="{DynamicResource hostsTab.intro}" Style="{StaticResource SecondaryText}" Margin="0,8,0,16"/>
              <Border Style="{StaticResource InfoBar}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource hostsTab.warn}" TextWrapping="Wrap"/>
                </Grid>
              </Border>
              <ItemsControl x:Name="HostsItems" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" IsHitTestVisible="{Binding IsIdle}"/>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding HostsPendingText}" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                  <WrapPanel Grid.Row="1">
                    <Button x:Name="BtnHostsApply" Style="{StaticResource AccentButton}" Content="{DynamicResource hostsTab.apply}" Margin="0,0,8,6" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnHostsRemove" Content="{DynamicResource hostsTab.remove}" Margin="0,0,8,6" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnHostsLoad" Content="{DynamicResource hostsTab.load}" Margin="0,0,8,6" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnHostsPreview" Content="{DynamicResource hostsTab.preview}" Margin="0,0,8,6" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnHostsOpen" Style="{StaticResource SubtleButton}" Content="{DynamicResource hostsTab.open}" Margin="0,0,8,6"/>
                  </WrapPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ Search and startup ============ -->
          <ScrollViewer x:Name="PageSearch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="40,34,40,40" MaxWidth="1040">
              <TextBlock Text="{DynamicResource tab.searchStartup}" Style="{StaticResource TitleText}"/>
              <TextBlock Text="{DynamicResource searchTab.intro}" Style="{StaticResource SecondaryText}" Margin="0,8,0,18"/>

              <!-- Default search engine -->
              <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                  <Grid Margin="16,13,16,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource RowIcon}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource searchTab.secSearch}" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource searchTab.chkSearch}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkSearch" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SearchEnabled}"
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="56,14,16,16" IsEnabled="{Binding SearchEnabled}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource searchTab.engineLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <ComboBox x:Name="CmbEngine" Grid.Column="1" HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,8"
                                ItemsSource="{Binding EngineItems}" SelectedIndex="{Binding EngineIndex}"/>
                      <TextBlock Grid.Row="1" Text="{DynamicResource searchTab.customLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoBox}" Margin="0,0,0,8"
                               Text="{Binding CustomSearchUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CustomSearchUrlEnabled}"/>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource searchTab.searchHelp}" Style="{StaticResource CaptionText}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- New tab page -->
              <Border Style="{StaticResource Card}" Padding="0" Margin="0,4,0,4">
                <StackPanel>
                  <Grid Margin="16,13,16,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xECC8;" Style="{StaticResource RowIcon}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource searchTab.secNtp}" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource searchTab.chkNtp}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkNtp" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NtpEnabled}"
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="56,14,16,16" IsEnabled="{Binding NtpEnabled}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource searchTab.ntpOpenLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <ComboBox x:Name="CmbNtp" Grid.Column="1" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,8"
                                ItemsSource="{Binding DestinationItems}" SelectedIndex="{Binding DestinationIndex}"/>
                      <TextBlock Grid.Row="1" Text="{DynamicResource searchTab.ntpCustomLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoBox}"
                               Text="{Binding NtpCustomUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NtpCustomUrlEnabled}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Homepage (the home button) -->
              <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,4">
                <StackPanel>
                  <Grid Margin="16,13,16,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE80F;" Style="{StaticResource RowIcon}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource searchTab.secHome}" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource searchTab.chkHome}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkHome" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HomeEnabled}"
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="56,14,16,16" IsEnabled="{Binding HomeEnabled}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource searchTab.ntpOpenLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <ComboBox x:Name="CmbHome" Grid.Column="1" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,8"
                                ItemsSource="{Binding HomeDestinationItems}" SelectedIndex="{Binding HomeDestinationIndex}"/>
                      <TextBlock Grid.Row="1" Text="{DynamicResource searchTab.ntpCustomLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoBox}"
                               Text="{Binding HomeCustomUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HomeCustomUrlEnabled}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Startup -->
              <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                  <Grid Margin="16,13,16,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{DynamicResource searchTab.secStartup}" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource searchTab.chkStartup}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkStartup" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartupEnabled}"
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                  </Grid>
                  <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="56,14,16,16" IsEnabled="{Binding StartupEnabled}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource searchTab.modeLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <ComboBox x:Name="CmbStartup" Grid.Column="1" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,8"
                                ItemsSource="{Binding StartupModeItems}" SelectedIndex="{Binding StartupModeIndex}"/>
                      <TextBlock Grid.Row="1" Text="{DynamicResource searchTab.urlLabel}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoBox}" Margin="0,0,0,8"
                               Text="{Binding StartupUrls, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding StartupUrlsEnabled}"/>
                      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource searchTab.startupHelp}" Style="{StaticResource CaptionText}"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource InfoBar}" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                  <TextBlock Grid.Column="1" Text="{DynamicResource searchTab.conflictNote}" TextWrapping="Wrap" FontSize="13"/>
                </Grid>
              </Border>

              <TextBlock Text="{DynamicResource ext.section}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}" Padding="20,16,20,16">
                <StackPanel>
                  <TextBlock Text="{DynamicResource ext.intro}" Style="{StaticResource SecondaryText}"/>
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource CautionText}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource ext.warn}" Style="{StaticResource CaptionText}"/>
                  </Grid>
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnExtUbo" Content="{DynamicResource ext.uboLite}" Margin="0,0,8,6"/>
                    <Button x:Name="BtnExtShields" Content="{DynamicResource ext.shields}" Margin="0,0,8,6"/>
                    <Button x:Name="BtnExtBitwarden" Content="{DynamicResource ext.bitwarden}" Margin="0,0,8,6"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============ Scriptlets ============ -->
          <Grid x:Name="PageScriptlets" Margin="40,34,40,18" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*" MinHeight="180"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource tab.scriptlets}" Style="{StaticResource TitleText}"/>
              <TextBlock Text="{DynamicResource scriptlet.intro}" Style="{StaticResource SecondaryText}" Margin="0,8,0,14"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CautionBar}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{DynamicResource CautionText}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource scriptlet.risk}" TextWrapping="Wrap" FontSize="13"/>
              </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,4,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource scriptlet.rootLabel}" Style="{StaticResource CaptionText}" Margin="2,0,0,6"/>
                <TextBox x:Name="TxtScriptletRoot" Grid.Row="1" Style="{StaticResource MonoBox}"
                         Text="{Binding ScriptletRoot, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                  <Button x:Name="BtnScriptletAuto" Content="{DynamicResource scriptlet.autoPath}" Style="{StaticResource SubtleButton}"/>
                  <Button x:Name="BtnScriptletBrowse" Content="{DynamicResource scriptlet.browse}" Margin="4,0,0,0"/>
                  <Button x:Name="BtnScriptletFolder" Content="{DynamicResource scriptlet.openFolder}" Margin="8,0,0,0"/>
                  <Button x:Name="BtnScriptletScan" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="96" Content="{Binding ScanButtonText}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="560"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBox x:Name="TxtScriptletSearch" Tag="{DynamicResource scriptlet.searchPlaceholder}" Padding="8,5,32,6"/>
                <TextBlock Text="&#xE71C;" Style="{StaticResource IconText}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,11,0"
                           Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False"/>
              </Grid>
              <CheckBox x:Name="ChkScriptletDisabledOnly" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="20,0,0,0"
                        Content="{DynamicResource scriptlet.disabledOnly}" IsChecked="{Binding ScriptletDisabledOnly}"/>
            </Grid>
            <DataGrid x:Name="ScriptletGrid" Grid.Row="4" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="44" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Picked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="86">
                  <DataGridTemplateColumn.Header>
                    <TextBlock Text="{DynamicResource scriptlet.col.status}"/>
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock x:Name="State" Text="{DynamicResource scriptlet.state.enabled}" Foreground="{DynamicResource SuccessText}"/>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                          <Setter TargetName="State" Property="Text" Value="{DynamicResource scriptlet.state.disabled}"/>
                          <Setter TargetName="State" Property="Foreground" Value="{DynamicResource DangerText}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Binding="{Binding Domain}" Width="1.2*">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.domain}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Scriptlet}" Width="1.1*">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.scriptlet}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Arguments}" Width="1.5*">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.arguments}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding SourceText}" Width="1.1*">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.source}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding LineNumber}" Width="64">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.line}"/></DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Rule}" Width="2.4*">
                  <DataGridTextColumn.Header><TextBlock Text="{DynamicResource scriptlet.col.rawRule}"/></DataGridTextColumn.Header>
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                      <Setter Property="FontSize" Value="12"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="5" Margin="0,10,0,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{Binding ScriptletStatus}" Style="{StaticResource CaptionText}"/>
              <ProgressBar Grid.Row="1" Margin="0,6,0,0" Maximum="1000" Value="{Binding ScriptletProgress}" Visibility="{Binding ScriptletProgressVisibility}"/>
            </Grid>
            <Grid Grid.Row="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <!-- The two switches that govern every edit sit right above the edit buttons. -->
              <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                <CheckBox x:Name="ChkScriptletAdvanced" Style="{StaticResource ToggleSwitch}" Margin="0,0,24,0"
                          IsChecked="{Binding ScriptletAdvanced}">
                  <TextBlock Text="{DynamicResource scriptlet.advancedMode}" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="ChkScriptletDupes" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource scriptlet.affectDupes}"
                          ToolTip="{DynamicResource scriptlet.tipAffectDupes}" IsChecked="{Binding ScriptletAffectDupes}"/>
              </WrapPanel>
              <WrapPanel Grid.Row="1">
                <Button x:Name="BtnScriptletDisable" Style="{StaticResource DangerButton}" Content="{DynamicResource scriptlet.disableChecked}" Margin="0,0,8,6" IsEnabled="{Binding IsIdle}"/>
                <Button x:Name="BtnScriptletEnable" Content="{DynamicResource scriptlet.enableChecked}" Margin="0,0,16,6" IsEnabled="{Binding IsIdle}"/>
                <Button x:Name="BtnScriptletCheckVisible" Style="{StaticResource SubtleButton}" Content="{DynamicResource scriptlet.checkFiltered}"
                        ToolTip="{DynamicResource scriptlet.tipCheckFiltered}" Margin="0,0,4,6"/>
                <Button x:Name="BtnScriptletClearChecks" Style="{StaticResource SubtleButton}" Content="{DynamicResource scriptlet.clearChecks}" Margin="0,0,12,6"/>
              </WrapPanel>
              <Button x:Name="BtnScriptletMore" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource scriptlet.more}"/>
                  <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11" Margin="8,1,0,0"/>
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="ScriptletMenu">
                    <MenuItem x:Name="MnuScriptletView" Header="{DynamicResource scriptlet.viewSelected}"/>
                    <Separator/>
                    <MenuItem x:Name="MnuScriptletBackup" Header="{DynamicResource scriptlet.backupAll}"/>
                    <MenuItem x:Name="MnuScriptletRestoreSel" Header="{DynamicResource scriptlet.restoreSelected}"/>
                    <MenuItem x:Name="MnuScriptletRestoreAll" Header="{DynamicResource scriptlet.restoreAll}"/>
                    <Separator/>
                    <MenuItem x:Name="MnuScriptletCsv" Header="{DynamicResource scriptlet.exportCsv}"/>
                    <MenuItem x:Name="MnuScriptletExportPrefs" Header="{DynamicResource scriptlet.exportPrefs}"/>
                    <MenuItem x:Name="MnuScriptletImportPrefs" Header="{DynamicResource scriptlet.importPrefs}"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>
          </Grid>

          <!-- ============ Settings ============ -->
          <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="40,34,40,40" MaxWidth="1040">
              <TextBlock Text="{DynamicResource nav.settings}" Style="{StaticResource TitleText}"/>

              <TextBlock Text="{DynamicResource settings.appearance}" Style="{StaticResource SectionText}" Margin="2,20,0,8"/>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xF2B7;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource settings.language}"/>
                    <TextBlock Text="{Binding LanguageNote}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ComboBox x:Name="CmbLanguage" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" Margin="16,0,0,0"
                            ItemsSource="{Binding LanguageItems}" SelectedIndex="{Binding LanguageIndex}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE790;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource settings.theme}"/>
                    <TextBlock Text="{DynamicResource settings.themeDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <ComboBox x:Name="CmbTheme" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" Margin="16,0,0,0"
                            ItemsSource="{Binding ThemeItems}" SelectedIndex="{Binding ThemeIndex}"/>
                </Grid>
              </Border>

              <TextBlock Text="{DynamicResource settings.target}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8B7;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource settings.policyKey}"/>
                    <TextBlock Text="{Binding PolicyKeyText}" Style="{StaticResource MonoText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{DynamicResource settings.policyKeyDesc}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <CheckBox x:Name="ChkBackup" Style="{StaticResource SettingCard}" IsChecked="{Binding Backup}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8F1;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource action.backup}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource settings.backupDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                </Grid>
              </CheckBox>

              <TextBlock Text="{DynamicResource settings.config}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE72C;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource util.loadState}"/>
                    <TextBlock Text="{DynamicResource settings.loadDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="BtnLoadState" Grid.Column="2" Content="{DynamicResource util.loadState}" MinWidth="150" Margin="16,0,0,0" IsEnabled="{Binding IsIdle}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE9D5;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource util.verify}"/>
                    <TextBlock Text="{DynamicResource settings.verifyDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="BtnVerify" Grid.Column="2" Content="{DynamicResource util.verify}" MinWidth="150" Margin="16,0,0,0" IsEnabled="{Binding IsIdle}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8A5;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource settings.configFile}"/>
                    <TextBlock Text="{DynamicResource settings.configDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button x:Name="BtnImport" Content="{DynamicResource util.import}" MinWidth="110" IsEnabled="{Binding IsIdle}"/>
                    <Button x:Name="BtnExport" Content="{DynamicResource util.export}" MinWidth="110" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8A7;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource util.openPolicy}"/>
                    <TextBlock Text="{DynamicResource settings.policyDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="BtnOpenPolicy" Grid.Column="2" Content="{DynamicResource settings.open}" MinWidth="150" Margin="16,0,0,0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE838;" Style="{StaticResource RowIcon}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource settings.backupFolder}"/>
                    <TextBlock Text="{DynamicResource settings.backupFolderDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="BtnBackupFolder" Grid.Column="2" Content="{DynamicResource settings.open}" MinWidth="150" Margin="16,0,0,0"/>
                </Grid>
              </Border>

              <TextBlock Text="{DynamicResource settings.restore}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE777;" Style="{StaticResource RowIcon}" Foreground="{DynamicResource DangerText}"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource action.fullRestore}"/>
                    <TextBlock Text="{DynamicResource settings.restoreDesc}" Style="{StaticResource CaptionText}"/>
                  </StackPanel>
                  <Button x:Name="BtnFullRestore" Grid.Column="2" Style="{StaticResource DangerButton}" Content="{DynamicResource action.fullRestore}"
                          MinWidth="150" Margin="16,0,0,0" IsEnabled="{Binding IsIdle}"/>
                </Grid>
              </Border>

              <TextBlock Text="{DynamicResource settings.about}" Style="{StaticResource SectionText}"/>
              <Border Style="{StaticResource Card}" Padding="20,16,20,16">
                <StackPanel>
                  <TextBlock Text="{Binding AboutTitle}" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource header.originNote}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ============ Toast ============ -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20" MaxWidth="460"
                Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1"
                CornerRadius="8" Padding="14,12,8,13" Visibility="Collapsed">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.22"/>
          </Border.Effect>
          <Border.RenderTransform>
            <TranslateTransform/>
          </Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToastIcon" Style="{StaticResource IconText}" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0"/>
            <StackPanel Grid.Column="1" Margin="12,0,8,0">
              <TextBlock x:Name="ToastTitle" Style="{StaticResource StrongText}"/>
              <TextBlock x:Name="ToastText" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="ToastClose" Grid.Column="2" Style="{StaticResource SubtleButton}" Padding="7,5,7,5" MinHeight="0" VerticalAlignment="Top">
              <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11"/>
            </Button>
          </Grid>
        </Border>

        <!-- ============ Activity log ============ -->
        <Border x:Name="ActivityPanel" Grid.Row="1" Height="0" Background="{DynamicResource LayerBg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" ClipToBounds="True">
          <Grid Margin="20,8,14,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="{DynamicResource activity.title}" Style="{StaticResource StrongText}" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLogCopy" Style="{StaticResource SubtleButton}" Content="{DynamicResource activity.copy}" MinHeight="28" Padding="10,3,10,4"/>
                <Button x:Name="BtnLogClear" Style="{StaticResource SubtleButton}" Content="{DynamicResource activity.clear}" MinHeight="28" Padding="10,3,10,4" Margin="4,0,0,0"/>
                <Button x:Name="BtnLogClose" Style="{StaticResource SubtleButton}" MinHeight="28" Padding="8,3,8,4" Margin="4,0,0,0">
                  <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="11"/>
                </Button>
              </StackPanel>
            </Grid>
            <ListBox x:Name="LogList" Grid.Row="1" Margin="-6,6,0,0" ItemContainerStyle="{StaticResource LogItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     FontFamily="{StaticResource MonoFont}" FontSize="12">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock x:Name="Lvl" Grid.Column="1" Text="{Binding Level}" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="OK">
                      <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource SuccessText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="DONE">
                      <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource AccentText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                      <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource CautionText}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="ERR">
                      <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource DangerText}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <!-- ============ Action bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
          <Grid>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Visibility="{Binding BusyVisibility}" VerticalAlignment="Top" Height="2" Background="Transparent"/>
            <Grid Margin="22,12,16,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding BarTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding BarSubtitle}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnActivity" Style="{StaticResource SubtleButton}" Margin="0,0,0,0" Padding="9,5,9,6"
                        ToolTip="{DynamicResource bar.activity}" AutomationProperties.Name="{DynamicResource bar.activity}">
                  <Grid>
                    <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}"/>
                    <Border Background="{DynamicResource Danger}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-9,0" Visibility="{Binding AlertVisibility}">
                      <TextBlock Text="{Binding AlertCount}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource OnDanger}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Button>
                <Button x:Name="BtnPreview" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B3;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource action.preview}"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnApply" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Padding="16,5,18,6" IsEnabled="{Binding IsIdle}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource OnAccent}"/>
                    <TextBlock Text="{DynamicResource action.apply}" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ================= Dialog layer ================= -->
    <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Border x:Name="DialogScrim" Background="{DynamicResource Scrim}"/>
      <Border x:Name="DialogCard" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" MaxWidth="560" Margin="48"
              Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuStroke}" BorderThickness="1" CornerRadius="8"
              RenderTransformOrigin="0.5,0.5" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.3"/>
        </Border.Effect>
        <Border.RenderTransform>
          <ScaleTransform/>
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DialogIcon" Style="{StaticResource IconText}" FontSize="20" Margin="0,0,12,0"/>
              <TextBlock x:Name="DialogTitle" Grid.Column="1" Style="{StaticResource SubtitleText}" VerticalAlignment="Center"/>
            </Grid>
            <!-- Shown when the dialog has a plain-language summary next to its report. -->
            <StackPanel x:Name="DialogTabs" Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
              <RadioButton x:Name="DialogTabSummary" Style="{StaticResource DialogTab}" GroupName="DialogTabs"
                           Content="{DynamicResource preview.tabSummary}" IsChecked="True"/>
              <RadioButton x:Name="DialogTabDetails" Style="{StaticResource DialogTab}" GroupName="DialogTabs"
                           Content="{DynamicResource preview.tabDetails}"/>
            </StackPanel>
            <ScrollViewer x:Name="DialogBodyScroll" Grid.Row="2" Margin="0,14,0,0" MaxHeight="380" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="DialogBody" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
            </ScrollViewer>
            <TextBox x:Name="DialogReport" Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource ReportBox}" Visibility="Collapsed"/>
            <ScrollViewer x:Name="DialogSummaryScroll" Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <ItemsControl x:Name="DialogSummary" ItemTemplate="{StaticResource SummaryTemplate}" Margin="0,0,14,0" Focusable="False"/>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource LayerBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                  CornerRadius="0,0,8,8" Padding="24,18,24,18">
            <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
